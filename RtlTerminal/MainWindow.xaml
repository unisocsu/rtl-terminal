<Window x:Class="RtlTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="RTL Terminal" Height="600" Width="950"
        Background="{StaticResource TerminalBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <DockPanel Grid.Row="0" Background="{StaticResource TabBarBackground}" LastChildFill="False">
            <ItemsControl x:Name="TabStripItems" DockPanel.Dock="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource TabBorder}" BorderThickness="1,0,1,0"
                                Background="{StaticResource TabInactiveBackground}"
                                Tag="{Binding}" MouseLeftButtonUp="TabHeader_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal" Margin="10,6,6,6">
                                <TextBlock Text="{Binding Title}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="✕" Width="20" Height="20" Padding="0"
                                        Background="Transparent" BorderThickness="0" Foreground="#AAAAAA"
                                        Tag="{Binding}" Click="CloseTabButton_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="NewTabButton" Content="+" Width="32" DockPanel.Dock="Left"
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    FontSize="16" Click="NewTabButton_Click" ToolTip="כרטיסייה חדשה (Ctrl+T)"/>
        </DockPanel>

        <!-- Active terminal host -->
        <Border Grid.Row="1" x:Name="TerminalHost" Background="{StaticResource TerminalBackground}"/>
    </Grid>
</Window>
